<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>StationAssistant</AssemblyName>
    <Product>Station Assistant</Product>
    <Version>1.1.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Plugin sources live at the plugin root; the tests\ subproject is separate (net8.0, headless). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>

    <!-- GameDir / PinnedRefs / ManagedDir / BepInExCore all resolve in Directory.Build.props, which
         MSBuild imports automatically. They were duplicated here in every plugin, pinned version
         included, which is why the pin was never bumped when the game updated. -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(ManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Shared neutral settings-window host, compiled in (no shared DLL) so the plugin stays a single
       self-contained assembly. One source of truth in the workspace; cross-mod calls reflect. -->
  <ItemGroup>
    <Compile Include="..\Shared\ModHost.cs" Link="ModHost.cs" />
    <Compile Include="..\Shared\LoadoutCore.cs" Link="LoadoutCore.cs" />
    <Compile Include="..\Shared\LoadoutStore.cs" Link="LoadoutStore.cs" />
    <!-- Game-free pure cores (also linked by tests\ and unit-tested headless). -->
    <Compile Include="..\Shared\Purchase.cs" Link="Purchase.cs" />
    <Compile Include="..\Shared\Rarity.cs" Link="Rarity.cs" />
    <Compile Include="..\Shared\KeepMatch.cs" Link="KeepMatch.cs" />
    <!-- Game-bound shared adapters (buy executor, station shop enumeration). -->
    <Compile Include="..\Shared\PurchaseExec.cs" Link="PurchaseExec.cs" />
    <Compile Include="..\Shared\GameMembers.cs" Link="GameMembers.cs" />
    <Compile Include="..\Shared\GameState.cs" Link="GameState.cs" />
    <Compile Include="..\Shared\Wallet.cs" Link="Wallet.cs" />
    <Compile Include="..\Shared\ItemFlags.cs" Link="ItemFlags.cs" />
    <Compile Include="..\Shared\GameShops.cs" Link="GameShops.cs" />
    <Compile Include="..\Shared\ItemNames.cs" Link="ItemNames.cs" />
    <Compile Include="..\Shared\Say.cs" Link="Say.cs" />
  </ItemGroup>

  <!-- Language files shipped with the plugin (authoritative sources live in the repo). -->
  <ItemGroup>
    <LangFiles Include="lang\*.lang" />
  </ItemGroup>

  <!-- Drop the built DLL + language files straight into the game's plugin folder on every build. Nothing
       else is copied because nothing else is needed: the plugin is ONE self-contained assembly, and the game
       references resolve from the game itself (Private=false). -->
  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(LangFiles)"
          DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)\lang"
          SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Deployed $(AssemblyName).dll + lang -> $(GameDir)\BepInEx\plugins\$(AssemblyName)" />
  </Target>

</Project>

